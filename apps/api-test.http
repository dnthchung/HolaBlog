### Variables
@baseUrl = http://localhost:3000
@apiVersion = v1
@apiUrl = {{baseUrl}}/api/{{apiVersion}}

#########################################
# Base Endpoints
#########################################

### Check if server is running
GET {{baseUrl}}/

### API Info
GET {{apiUrl}}/

#########################################
# User Endpoints
#########################################

### Get all users
GET {{apiUrl}}/users

### Get user by ID
GET {{apiUrl}}/users/1

### Create a new user
POST {{apiUrl}}/users
Content-Type: application/json

{
  "username": "johndoe",
  "email": "john.doe@example.com",
  "fullName": "John Doe",
  "bio": "A passionate blogger",
  "avatar": "https://example.com/avatar.jpg"
}

### Update user
PUT {{apiUrl}}/users/1
Content-Type: application/json

{
  "username": "johndoe_updated",
  "email": "john.updated@example.com",
  "fullName": "John Doe Updated",
  "bio": "An updated passionate blogger"
}

### Delete user
DELETE {{apiUrl}}/users/1

#########################################
# Blog Endpoints
#########################################

### Get all blogs
GET {{apiUrl}}/blogs

### Get all blogs with status filter
GET {{apiUrl}}/blogs?status=published

### Get all blogs with author filter
GET {{apiUrl}}/blogs?authorId=1

### Get blog by slug
GET {{apiUrl}}/blogs/my-first-blog-post

### Create a new blog
POST {{apiUrl}}/blogs
Content-Type: application/json

{
  "title": "My First Blog Post",
  "slug": "my-first-blog-post",
  "content": "This is the content of my first blog post. It contains some interesting information about web development.",
  "excerpt": "A brief introduction to web development",
  "featuredImage": "https://example.com/featured-image.jpg",
  "status": "draft",
  "authorId": 1
}

### Create a published blog
POST {{apiUrl}}/blogs
Content-Type: application/json

{
  "title": "Advanced JavaScript Tips",
  "slug": "advanced-javascript-tips",
  "content": "Here are some advanced JavaScript tips that will help you write better code...",
  "excerpt": "Learn advanced JavaScript techniques",
  "featuredImage": "https://example.com/js-tips.jpg",
  "status": "published",
  "authorId": 1,
  "publishedAt": "2025-01-19T10:00:00Z"
}

### Update blog
PUT {{apiUrl}}/blogs/1
Content-Type: application/json

{
  "title": "My Updated Blog Post",
  "content": "This is the updated content of my blog post.",
  "status": "published",
  "publishedAt": "2025-01-19T12:00:00Z"
}

### Delete blog
DELETE {{apiUrl}}/blogs/1

#########################################
# Error Testing
#########################################

### Test 404 - Non-existent endpoint
GET {{apiUrl}}/nonexistent

### Test 404 - Non-existent user
GET {{apiUrl}}/users/999

### Test 404 - Non-existent blog
GET {{apiUrl}}/blogs/non-existent-slug

### Test validation error - Invalid user data
POST {{apiUrl}}/users
Content-Type: application/json

{
  "username": "ab",
  "email": "invalid-email",
  "fullName": ""
}

### Test validation error - Invalid blog data
POST {{apiUrl}}/blogs
Content-Type: application/json

{
  "title": "",
  "content": "",
  "authorId": "invalid"
}